{
  "env": {
    "es2021": true,
    "node": true
  },
  "extends": [
    "eslint:recommended",
    "plugin:import/recommended",
    "plugin:import/typescript",
    "prettier"
  ],
  "plugins": ["@typescript-eslint", "unused-imports"],
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "overrides": [
    {
      "files": ["*.ts"],
      "parserOptions": {
        "project": "./tsconfig.json",
        "tsconfigRootDir": "."
      },
      "extends": ["plugin:@typescript-eslint/recommended"],
      "rules": {
        "@typescript-eslint/no-unused-vars": [
          "warn",
          { "args": "after-used", "ignoreRestSiblings": true }
        ],
        "@typescript-eslint/no-require-imports": "warn" // or "off" if you want to allow it in TS too
      }
    },
    {
      "files": ["*.js"],
      "rules": {
        "import/no-commonjs": "off",
        "import/no-unresolved": "off",
        "@typescript-eslint/no-require-imports": "off", // <-- important fix
        "no-unused-vars": [
          "warn",
          { "args": "after-used", "ignoreRestSiblings": true }
        ]
      }
    }
  ],
  "rules": {
    "semi": ["error", "always"],
    "no-console": "off",
    "no-redeclare": "error",
    "max-len": [
      "error",
      {
        "code": 150,
        "ignoreComments": true,
        "ignoreUrls": true,
        "ignoreStrings": true
      }
    ],
    "unused-imports/no-unused-imports": "warn",
    "import/order": [
      "warn",
      {
        "groups": ["builtin", "external", "internal"],
        "alphabetize": { "order": "asc", "caseInsensitive": true }
      }
    ]
  }
}