{
    "compilerOptions": {
      "target": "ES6",
      "module": "CommonJS",
      "strict": true,
      "esModuleInterop": true,
      "resolveJsonModule": true,
      "moduleResolution": "node",
      "sourceMap": true, 
      "forceConsistentCasingInFileNames": true ,
      "allowSyntheticDefaultImports": true,
      "jsx": "react",
      "outDir": "./dist",
      "baseUrl": "./",
      "paths": {
        "@/*": ["src/*"]
      }
    },
    "include": ["src/**/*", "errorMessage.json"],
    "exclude": ["node_modules", "dist"]
  }
  